sort ascending and decending string values usig streams

//Collections.sort(list) tries to change the same list, and List.of() makes an immutable (read-only) list, so it throws an error ❌

//stream().sorted().toList() creates a new sorted list instead of changing the original one, so no error happens

import java.util.*;
import java.lang.*;
import java.io.*;
import java.util.stream.*;

class Codechef
{
	public static void main (String[] args) throws java.lang.Exception
	{
	  
	  List<String> list= List.of("a","z","r","e"); //immutable
	  list=list.stream().sorted(Comparator.reverseOrder()).toList();
	  System.out.println(
	      "descending order "+list);
	  List<String> list1=list.stream().sorted().toList();
	  System.out.println("Ascending order "+list1);
	  
	  
	}
}

descending order [z, r, e, a]
Ascending order [a, e, r, z]
